	<!-- WHAT I DO -->
	<section id="services" class="mx-auto p-16 bg-darkblue-100">
		<div class="container">
			<div class="mb-12 text-center">
				<h2 class="font-extrabold text-white text-center">What I can help you with</h2>
			</div>

			{% set services = [
				{
					title: 'Web Design',
					body: 'Web design for your business or small project.',
					icon: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M6.5 6.5h.01M9 6.5h.01M7 13h5M7 16h3"/><rect x="14.5" y="12.5" width="3" height="4" rx=".5"/>'
				},
				{
					title: 'Shopify Development',
					body: 'Creating bespoke Shopify stores that drive sales.',
					icon: '<path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 8z"/><path d="M9 11V6a3 3 0 0 1 6 0v5"/>'
				},
				{
					title: 'SEO',
					body: 'Built in from day one, not bolted on afterwards.',
					icon: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="m20 20-4.8-4.8M7.5 12.5l2-2 1.5 1.5 2.5-2.5"/>'
				},
			] %}

			<div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-3 gap-6">
				{% for service in services %}
					<div class="group bg-navy-card rounded-2xl p-8 border rounded-xl border-white/6 hover:border-accent/40 hover:-translate-y-1 transition-all">
						<!--<div class="text-sm font-bold text-accent mb-6">{{ '%02d'|format(loop.index) }}</div>-->
						<div class="flex items-center justify-center w-12 h-12 mb-6 rounded-xl bg-accent/10 text-accent group-hover:bg-accent/20 transition-colors">
							<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ service.icon|raw }}</svg>
						</div>
						<h3 class="text-white font-bold text-xl mb-3 group-hover:text-accent transition-colors">{{ service.title }}</h3>
						<p class="text-text-muted font-light text-base leading-7 mb-0">{{ service.body }}</p>
					</div>
				{% endfor %}
			</div>
		</div>
	</section>

	<section id="work" class="container mx-auto py-16 px-2">
		<div class="flex items-baseline justify-center mb-12">
			<h2 class="font-extrabold text-white text-center">Work</h2>
		</div>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			{% for post in posts %}
				{{ article.teaser({post: post, featured: true}) }}
			{% endfor %}
		</div>
		{% include '_partials/pagination' with { pageInfo: pageInfo } %}
	</section>


	<section class="container py-16">
		<div class="bg-white p-8 rounded-xl">
			<h2 class="font-extrabold text-[clamp(2rem,3.5vw,3.2rem)] leading-[1.1] text-navy tracking-[-0.03em]">
				Get a project? Let's work together.
			</h2>
			<p>Whether it’s a full build, a redesign, or a “this isn’t working and I don’t know why,” I’d love to hear about it.
			</p>
			<a href="mailto:samheadland9@gmail.com" class="inline-flex items-center gap-2 px-7 py-3 bg-accent text-navy rounded-full font-semibold text-sm hover:-translate-y-0.5 hover:shadow-[0_8px_24px_color-mix(in_srgb,#4ec9a0_25%,transparent)] transition-all no-underline">Send me an email</a>

		</div>
	</section>
{% endblock %}
