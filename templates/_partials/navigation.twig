  {% set pages = craft.entries.section('pages').level(1).all() %}
  <button type="button" class="sm:hidden relative z-50 p-2" aria-controls="primary-nav" aria-expanded="false" data-nav-toggle>
    <span class="sr-only">Menu</span>
    <svg class="w-7 h-7" data-nav-icon="open" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
    <svg class="w-7 h-7 hidden" data-nav-icon="close" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <nav id="primary-nav" class="hidden fixed inset-0 z-40 items-center justify-center bg-darkblue sm:static sm:block sm:bg-transparent" aria-label="Primary">
    <ul class="sm:flex font-bold text-3xl sm:text-lg text-center sm:text-left space-y-4 sm:space-y-0">
      <li><a href="#about" class="block p-2 hover:underline">About</a></li>
      <li><a href="/work" class="block p-2 hover:underline">Work</a></li>
      <li><a href="#contact" class="block p-2 hover:underline">Contact</a></li>

      {#% for page in pages %}
        <li><a href="{{ page.url }}" class="block p-2 hover:underline hover:text-red-600{% if segment1 == page.slug %} text-red-600" aria-current="page{% endif %}">{{ page.title }}</a></li>
      {% endfor %#}
    </ul>
  </nav>
  <script>
    (function () {
      var toggle = document.querySelector('[data-nav-toggle]');
      var nav = document.getElementById('primary-nav');
      function setOpen(open) {
        toggle.setAttribute('aria-expanded', open);
        nav.classList.toggle('hidden', !open);
        nav.classList.toggle('flex', open);
        document.body.classList.toggle('overflow-hidden', open);
        toggle.querySelector('[data-nav-icon="open"]').classList.toggle('hidden', open);
        toggle.querySelector('[data-nav-icon="close"]').classList.toggle('hidden', !open);
      }
      toggle.addEventListener('click', function () {
        setOpen(toggle.getAttribute('aria-expanded') !== 'true');
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
          toggle.focus();
        }
      });
      // Reset if the viewport grows past the mobile breakpoint while open
      window.matchMedia('(min-width: 40rem)').addEventListener('change', function (e) {
        if (e.matches) setOpen(false);
      });
      // Close after tapping an in-page link so the section isn't hidden behind the menu
      nav.addEventListener('click', function (e) {
        if (e.target.closest('a')) setOpen(false);
      });
    })();
  </script>
